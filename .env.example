# ============ 환경 ============
ENV=local
LOG_LEVEL=INFO

# ============ Database (로컬 PostgreSQL) ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brbs_dev

# ============ SQS (로컬 LocalStack :4566 / 배포 AWS SQS Standard) ============
# 큐는 전체 URL로 지정한다(토픽명 아님). 로컬은 LocalStack 엔드포인트 + 더미 자격증명(아래 AWS).
SQS_OCR_JOB_QUEUE_URL=http://localhost:4566/000000000000/ocr-job-queue
SQS_REPORT_JOB_QUEUE_URL=http://localhost:4566/000000000000/report-job
SQS_ENDPOINT_URL=http://localhost:4566
# 튜닝(선택 — 기본값이 코드에 있음): 롱폴링 대기·visibility·배치·poison 스킵 상한
# SQS_WAIT_TIME_SECONDS=20
# SQS_VISIBILITY_TIMEOUT=600
# SQS_MAX_MESSAGES=1
# SQS_MAX_RECEIVE_COUNT=5
# 워커별 관측성 라벨은 컨테이너 ENV로 오버라이드(예: SERVICE_NAME=report-worker, Dockerfile에 설정).
# 배포(AWS SQS): SQS_ENDPOINT_URL을 비우면 실 AWS 기본 엔드포인트. 자격증명은 워커 IAM Role
# (정적 키 없음). 큐 URL 형식: https://sqs.<region>.amazonaws.com/<account-id>/<queue>. AWS_REGION 필수(아래).

# ============ AI 서빙 (챗) — provider 스위치 ============
# LLM_PROVIDER: anthropic(코드 기본 — Claude API, 공식 SDK) | openai_compat(Ollama 등 OpenAI 호환 /v1)
# 로컬 개발은 아래처럼 openai_compat을 명시해 로컬 Ollama를 쓴다.
# 아래는 로컬 개발 기본값. 배포(GPU 노드) LLM은 Qwen3 MoE(qwen3.6:35b-a3b) 확정(8/4).
# EXAONE은 라이선스(상업 사용 금지)로 불가.
LLM_PROVIDER=openai_compat
# openai_compat 챗 엔드포인트(anthropic이면 쓰지 않는다)
AI_BASE_URL=http://localhost:11434/v1
# 챗 인증키. anthropic이면 Claude API 키(시크릿 — 커밋 금지). 임베딩 요청엔 실리지 않는다.
AI_API_KEY=not-needed
LLM_MODEL=gemma3:12b
# anthropic 전용(선택 — 기본값이 코드에 있음). Opus 5.5는 thinking이 항상 켜져 있고 깊이는
# effort로만 조절한다(low|medium|high|xhigh|max). max_tokens는 thinking+응답 합산 상한.
# LLM_EFFORT=high
# LLM_MAX_TOKENS=64000
# LLM_TIMEOUT_SECONDS=600
# Claude로 바꿀 때: LLM_PROVIDER=anthropic, AI_API_KEY=<Claude API 키>, LLM_MODEL=claude-opus-5-5

# ============ 임베딩 — provider 스위치 ============
# EMBEDDING_PROVIDER: voyage(코드 기본 — MongoDB Atlas 모델 API) | openai_compat(로컬 Ollama 등)
# 로컬 개발은 아래처럼 openai_compat을 명시한다.
# 코퍼스 적재에 쓴 모델과 쿼리 모델이 같아야 한다(바꾸면 코퍼스 전체 재임베딩).
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_BASE_URL=http://localhost:11434/v1
# 임베딩 전용 인증키(챗 키와 분리). not-needed면 인증 헤더를 붙이지 않는다.
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
# Voyage로 바꿀 때: EMBEDDING_PROVIDER=voyage, EMBEDDING_BASE_URL=https://ai.mongodb.com/v1,
# EMBEDDING_MODEL=voyage-4-large, EMBEDDING_API_KEY=<Atlas 모델 API 키>(시크릿 — 커밋 금지)

# ============ VLM(Vision) — OCR 쪽 전사·라인 재판독(ocr_worker.vlm_client) ============
# OpenAI 호환 /v1/chat/completions. 운영은 클러스터 vLLM의 PaddleOCR-VL-1.6(charts/etl-vllm,
# k8s 같은 ns는 http://vllm:8000). 로컬은 vLLM을 띄우거나(기본 포트 8000), Ollama의 범용 VLM을
# 쓴다(VLM_BASE_URL=http://localhost:11434 + 그 모델명). 모델명에 paddleocr가 없으면 태스크 토큰
# 대신 한국어 지시문 프롬프트로 바뀐다.
VLM_BASE_URL=http://localhost:8000
VLM_MODEL=PaddleOCR-VL-1.6-0.9B
# 튜닝(선택 — 기본값과 근거·SQS 가시성 600초 안의 최악 경로 계산은 src/core/config.py VLM 섹션)
# VLM_MAX_TOKENS=3072
# VLM_TIMEOUT_SECONDS=180
# VLM_CONNECT_TIMEOUT_SECONDS=5
# VLM_REREAD_MAX_TOKENS=128
# VLM_REREAD_TIMEOUT_SECONDS=30
# VLM_CONCURRENCY=4
# VLM_PAGE_BUDGET_SECONDS=210
# VLM_REREAD_BUDGET_SECONDS=90
# (두 예산 + VLM 외 몫 240 + 안전 여유 60이 SQS_VISIBILITY_TIMEOUT(600)을 넘으면 ocr_worker가 기동을 거부한다)

# ============ 이름 마스킹(NER) ============
# 정규식 문맥 앵커(의사명·서명란)만으론 "환자의 성명: OOO" 같은 일반 라벨-값
# 이름을 못 잡는다(실측 확인) — NER이 이름의 유일한 방어선이라 기본 켠다.
USE_NER=true

# ============ Backend 연결 ============
BACKEND_URL=http://localhost:8080

# ============ AWS ============
AWS_REGION=ap-northeast-2
S3_BUCKET=
# 로컬 LocalStack용 더미 자격증명(boto3 자격증명 체인이 요구). 실 AWS는 IAM Role이라 불필요 —
# 이 두 줄을 비우거나 지운다. compose에서 컨테이너 환경으로 주입해야 boto3(os.environ)가 읽는다.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ============ Notion (약관 코퍼스 소스) ============
# jjg 인테그레이션 시크릿(ntn_...). 커밋 금지 — 로컬 .env/SSM에만.
NOTION_TOKEN=
# 데이터 출처 카탈로그 / terms 파일 DB의 database id(/v1/databases/{id}/query용)
NOTION_CATALOG_DATABASE_ID=e6fa0ba5efb946c6934c195774e9b6e7
NOTION_CORPUS_DATABASE_ID=e2bde980f10741d8bcf35f2d60709171

# ============ Corpus S3 스테이징 ============
CORPUS_CATEGORIES=terms
S3_CORPUS_PREFIX=corpus/

# ============ OpenAI (fallback) ============
OPENAI_API_KEY=
