# ============ 환경 ============
ENV=local
LOG_LEVEL=INFO

# ============ Database (로컬 PostgreSQL) ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brbs_dev

# ============ Redis (로컬) ============
REDIS_URL=redis://localhost:6379/0

# ============ Kafka (로컬 apache/kafka — docker compose, KRaft / 배포 MSK) ============
# 호스트 실행 시 localhost:9092(EXTERNAL 리스너).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_OCR_JOB_TOPIC=ocr-job-queue
KAFKA_REPORT_JOB_TOPIC=report-job

# ============ AI 서빙 (Ollama) ============
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=not-needed
LLM_MODEL=gemma3:12b

# ============ 임베딩 ============
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ============ Backend 연결 ============
BACKEND_URL=http://localhost:8080

# ============ JWT ============
# 옵션 A: HS256 대칭키 공유
JWT_SECRET=localdevonlysecretkeyatleast32chars!!
# 옵션 B: RS256 공개키
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# ============ AWS ============
AWS_REGION=ap-northeast-2
S3_BUCKET=

# ============ OpenAI (fallback) ============
OPENAI_API_KEY=
