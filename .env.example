# 환경 (local / dev / prod)
ENV=local
LOG_LEVEL=INFO

# Database — AWS RDS (PostgreSQL + pgvector). 로컬은 별도 PG 사용.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aiengine

# Kafka — AWS MSK / 로컬 apache/kafka(docker compose, KRaft). 호스트 실행 시 localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_OCR_JOB_TOPIC=ocr-job-queue
KAFKA_REPORT_JOB_TOPIC=report-job

# AI 서빙 (OpenAI 호환 엔드포인트: Ollama/vLLM/TEI). 모델 미정 — 결정 후 채움.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=not-needed
LLM_MODEL=TBD
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=TBD
EMBEDDING_DIM=1024

# Redis — AWS ElastiCache / 로컬 redis
REDIS_URL=redis://localhost:6379/0

# JWT (RS256 공개키 — 챗봇 on-connect 검증)
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# S3 (OCR 원본 — OCR Worker가 GetObject)
AWS_REGION=ap-northeast-2
S3_BUCKET=
