# ============ 환경 ============
ENV=local
LOG_LEVEL=INFO

# ============ Database (로컬 PostgreSQL) ============
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brbs_dev

# ============ Redis (로컬) ============
REDIS_URL=redis://localhost:6379/0

# ============ Kafka (로컬 apache/kafka — docker compose, KRaft / 배포 MSK) ============
# 호스트 실행 시 localhost:9092(EXTERNAL 리스너).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_OCR_JOB_TOPIC=ocr-job-queue
KAFKA_REPORT_JOB_TOPIC=report-job
# 워커별 오버라이드 (컨테이너 ENV로 설정 권장; settings 기본 = ocr-worker)
# KAFKA_CONSUMER_GROUP=report-worker
# SERVICE_NAME=report-worker

# ============ AI 서빙 (Ollama) ============
# 아래는 로컬 개발 기본값. 배포(GPU 노드) LLM은 Qwen3 MoE(qwen3.6:35b-a3b) 확정(8/4),
# 임베딩 계약은 qwen3-embedding 1024d(BGE-M3 폴백). EXAONE은 라이선스(상업 사용 금지)로 불가.
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=not-needed
LLM_MODEL=gemma3:12b

# ============ 임베딩 ============
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ============ VLM(Vision) — 하이브리드 표 문서 보조 경로 ============
# Ollama 네이티브 /api/generate(OpenAI 호환 아님, ai_base_url과 별도 설정)
VLM_BASE_URL=http://localhost:11434
# 표 전사(텍스트만) — 팀 합의 모델.
VLM_MODEL=qwen3.6:35b-a3b
# 이미지 마스킹 보강용 PII 위치 grounding(좌표) 전용 — VLM_MODEL과 별도 고정(실측:
# 표 전사엔 더 정확한 위 모델도 grounding 좌표는 부정확했음).
VLM_GROUNDING_MODEL=qwen3-vl:8b-instruct
VLM_TIMEOUT_SECONDS=60

# ============ 이름 마스킹(NER) ============
# 정규식 문맥 앵커(의사명·서명란)만으론 "환자의 성명: OOO" 같은 일반 라벨-값
# 이름을 못 잡는다(실측 확인) — NER이 이름의 유일한 방어선이라 기본 켠다.
USE_NER=true

# ============ Backend 연결 ============
BACKEND_URL=http://localhost:8080

# ============ JWT ============
# 옵션 A: HS256 대칭키 공유
JWT_SECRET=localdevonlysecretkeyatleast32chars!!
# 옵션 B: RS256 공개키
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem

# ============ AWS ============
AWS_REGION=ap-northeast-2
S3_BUCKET=

# ============ Notion (약관 코퍼스 소스) ============
# jjg 인테그레이션 시크릿(ntn_...). 커밋 금지 — 로컬 .env/SSM에만.
NOTION_TOKEN=
# 데이터 출처 카탈로그 / terms 파일 DB의 database id(/v1/databases/{id}/query용)
NOTION_CATALOG_DATABASE_ID=e6fa0ba5efb946c6934c195774e9b6e7
NOTION_CORPUS_DATABASE_ID=e2bde980f10741d8bcf35f2d60709171

# ============ Corpus S3 스테이징 ============
CORPUS_CATEGORIES=terms
S3_CORPUS_PREFIX=corpus/

# ============ OpenAI (fallback) ============
OPENAI_API_KEY=
