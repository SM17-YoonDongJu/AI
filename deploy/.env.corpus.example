# corpus_worker 배포 환경변수 — 실제 파일은 /opt/corpus/.env.corpus (chmod 600, git 미커밋).
# REPLACE_ME 값은 실제 인프라 값으로 교체.

# ECR / 이미지
ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
CORPUS_TAG=dev

# 공통
ENV=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2

# S3 (약관 스테이징) — OCR과 같은 버킷 재사용 가능(corpus/ prefix로 분리)
S3_BUCKET=REPLACE_ME

# RDS (OCR과 동일 DB) — SSL 필수, CA 번들 마운트
DATABASE_URL=postgresql://postgres:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres
RDS_CA_PATH=/etc/ssl/rds/global-bundle.pem

# Notion (읽기 전용) — jjg 인테그레이션 시크릿(ntn_...)
NOTION_TOKEN=REPLACE_ME

# 폴링 주기(초). 약관 변경이 드물어 느슨히 — 6h. 증분이라 부담 적음. (database id는 config 기본값 사용)
NOTION_SYNC_INTERVAL_SECONDS=21600
CORPUS_CATEGORIES=terms
