{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConsumeOcrJobs",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:ap-northeast-2:REPLACE_ME_ACCOUNT_ID:brbs-ocr-job-queue-prod"
    },
    {
      "Sid": "PublishReportJobs",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:ap-northeast-2:REPLACE_ME_ACCOUNT_ID:brbs-report-job-queue-prod"
    },
    {
      "Sid": "OriginalsAndMaskedCopies",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_ME_BUCKET/*"
    }
  ]
}
