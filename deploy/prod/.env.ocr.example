# prod OCR 워커 EC2(brbs-ocr-prod) 환경변수 템플릿. 실제 파일은 호스트의 /opt/ocr/.env.ocr
# (root 소유, chmod 600, git 미커밋). REPLACE_ME를 실제 값으로 바꾼다.
# 레포가 public이라 계정 ID·RDS 주소·사설 IP도 여기엔 적지 않는다(값은 deploy/prod/README.md 절차대로 조회).
# OCR_TAG는 배포 워크플로(promote-ocr-prod.yml)가 매 배포마다 이 파일에 기록하므로 손대지 않는다.

ECR_REGISTRY=REPLACE_ME_ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com
OCR_TAG=

ENV=prod
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2
S3_BUCKET=REPLACE_ME

# brbs_prod DB, ai_owner_prod 롤. 롤은 deploy/schema_split.sql을 prod 롤 이름으로 실행해 만든다.
# 비밀번호에 $가 있으면 compose가 변수로 해석하므로 $$로 적는다.
DATABASE_URL=postgresql://ai_owner_prod:REPLACE_ME@REPLACE_ME_RDS_ENDPOINT:5432/brbs_prod

# 소비 큐(ocr)·발행 큐(report) — prod 큐. 자격증명은 인스턴스 역할(brbs-ocr-prod-role), 정적 키 없음.
SQS_OCR_JOB_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/REPLACE_ME_ACCOUNT_ID/brbs-ocr-job-queue-prod
SQS_REPORT_JOB_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/REPLACE_ME_ACCOUNT_ID/brbs-report-job-queue-prod

# 클러스터 vLLM(PaddleOCR-VL) — brbs-etl 사설 IP + NodePort(K8s-manifests envs/dev/etl-vllm.values.yaml).
# brbs-etl 사설 IP는 stop/start에도 유지된다.
VLM_BASE_URL=http://REPLACE_ME_BRBS_ETL_PRIVATE_IP:30800
VLM_MODEL=PaddleOCR-VL-1.6-0.9B

USE_NER=true
# OCR_CPU_THREADS=2
# OCR_DET_MODEL=PP-OCRv5_server_det
