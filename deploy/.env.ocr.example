# GPU EC2(AI subnet) 배포 환경변수 — 실제 파일은 /home/ubuntu/ocr/.env.ocr (chmod 600, git 미커밋).
# REPLACE_ME 값은 실제 인프라 값으로 교체.

# ECR / 이미지
ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
OCR_TAG=dev

# 공통
ENV=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2
S3_BUCKET=REPLACE_ME

# 네트워크 (private IP)
GPU_PRIVATE_IP=10.0.y.y            # 이 GPU EC2 자신의 private IP (ollama 바인딩용)
BACKEND_PRIVATE_IP=10.0.x.x        # backend EC2 private IP (참고)

# RDS (AI용 URL 형식)
DATABASE_URL=postgresql://postgres:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres
# RDS SSL 필수 — CA 번들 경로(컨테이너 내부). 비우면 SSL이 꺼져 RDS가 "no encryption"으로 접속 거부.
# 호스트에 번들 배치 후 compose 볼륨으로 마운트한 경로와 일치시킬 것.
RDS_CA_PATH=/etc/ssl/rds/global-bundle.pem

# SQS — AWS SQS(Standard 큐). 큐는 전체 URL로 지정한다. SQS_ENDPOINT_URL은 실 AWS에선 비운다.
# 자격증명: 워커 EC2 인스턴스 프로파일(IAM Role) — 정적 키 없음(AWS_REGION은 위에 있음).
#   워커 Role 권한(큐 ARN): sqs:ReceiveMessage · sqs:DeleteMessage(+Batch) · sqs:GetQueueUrl
#     · sqs:GetQueueAttributes · sqs:ChangeMessageVisibility.
#   네트워크: SQS는 퍼블릭 엔드포인트 — 프라이빗 서브넷이면 VPC 엔드포인트(interface) 또는 NAT 경유.
#   컨테이너 IMDS: EC2 메타데이터 hop-limit ≥ 2 여야 컨테이너가 IAM Role 자격증명을 받는다.
SQS_OCR_JOB_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/REPLACE_ME_ACCOUNT_ID/ocr-job-queue
SQS_REPORT_JOB_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/REPLACE_ME_ACCOUNT_ID/report-job

# 임베딩 (같은 박스 ollama)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# VLM(Vision, 같은 박스 ollama) — 하이브리드 표 문서 보조 경로
# ocr-worker와 ollama가 별도 컨테이너(ocr-net bridge)라 기본값(localhost)으로는 안 닿는다.
VLM_BASE_URL=http://ollama:11434
# 표 전사(텍스트만, 좌표 없음) — 팀 합의 모델.
VLM_MODEL=qwen3.6:35b-a3b
# 이미지 마스킹 보강용 PII 위치 grounding(좌표) 전용 — VLM_MODEL과 별도로 고정한다.
# 실측: 표 전사엔 더 정확한 위 모델도 grounding 좌표는 실제 텍스트 위치를 벗어남.
VLM_GROUNDING_MODEL=qwen3-vl:8b-instruct
VLM_TIMEOUT_SECONDS=60
# 명시 안 하면 ollama 기본 num_ctx가 페이지 이미지 토큰만으로 대부분 차, 표 문서
# 응답이 문장 중간에서 조용히 잘렸다(실측 확인).
VLM_NUM_CTX=16384

# 이름 마스킹(NER) — 정규식 문맥 앵커만으론 일반 라벨-값 이름을 못 잡아 기본 켠다
USE_NER=true
