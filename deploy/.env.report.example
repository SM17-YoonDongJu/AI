# backend EC2 배포 환경변수 템플릿 — report-worker 컨테이너용.
# 실제 파일(/home/ubuntu/backend/.env.dev)은 backend팀이 관리한다(git 미커밋, deploy/README §6).
# REPLACE_ME 값은 실제 인프라 값으로 교체.

# ECR / 이미지
ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
REPORT_TAG=dev

# 공통
ENV=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2

# 워커 식별 — settings 기본값이 ocr-worker라 report로 반드시 오버라이드
SERVICE_NAME=report-worker
KAFKA_CONSUMER_GROUP=report-worker

# RDS (AI용 URL 형식) + SSL CA 번들 — 비우면 SSL이 꺼져 RDS가 접속 거부(deploy/README §7)
DATABASE_URL=postgresql://postgres:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres
RDS_CA_PATH=/etc/ssl/rds/global-bundle.pem

# Kafka — backend EC2 브로커(EXTERNAL 리스너 :9094)
KAFKA_BOOTSTRAP_SERVERS=REPLACE_ME:9094
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_REPORT_JOB_TOPIC=report-job

# LLM (GPU EC2 ollama, OpenAI 호환 /v1) — 팀 확정(8/4): Qwen3 MoE.
# EXAONE은 라이선스(상업적 사용 금지)로 사용 불가.
AI_BASE_URL=http://10.0.y.y:11434/v1
AI_API_KEY=not-needed
LLM_MODEL=qwen3.6:35b-a3b

# 임베딩 (GPU EC2 ollama) — 코퍼스(policy/case/schedule_chunks) 적재에 쓴 모델과
# 반드시 동일해야 벡터공간이 일치한다. 현 계약: qwen3-embedding 1024d
# (쿼리 instruction 프리픽스는 코드가 부착). 실패 시 BGE-M3 로컬 폴백(차원 동일).
EMBEDDING_BASE_URL=http://10.0.y.y:11434/v1
EMBEDDING_MODEL=qwen3-embedding
EMBEDDING_DIM=1024
