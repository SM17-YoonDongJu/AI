# backend EC2 배포 환경변수 템플릿 — report-worker 컨테이너용.
# 실제 파일(/home/ubuntu/backend/.env.dev)은 backend팀이 관리한다(git 미커밋, deploy/README §6).
# REPLACE_ME 값은 실제 인프라 값으로 교체.

# ECR / 이미지
ECR_REGISTRY=938500344078.dkr.ecr.ap-northeast-2.amazonaws.com
REPORT_TAG=dev

# 공통
ENV=dev
LOG_LEVEL=INFO
AWS_REGION=ap-northeast-2

# 워커 식별 — settings 기본값이 ocr-worker라 report로 반드시 오버라이드
SERVICE_NAME=report-worker

# RDS (AI용 URL 형식) + SSL CA 번들 — 비우면 SSL이 꺼져 RDS가 접속 거부(deploy/README §7)
DATABASE_URL=postgresql://ai_owner:REPLACE_ME@brbs-rds-dev.cd0y2mqse6ap.ap-northeast-2.rds.amazonaws.com:5432/postgres
RDS_CA_PATH=/etc/ssl/rds/global-bundle.pem

# PII 컬럼 복호화(core.crypto) — user_claims/user_insurances 일부 컬럼을 백엔드가
# AES-256-GCM으로 암호화해 저장한다. dev는 KMS 없이 이 base64 32바이트 키를 그대로 DEK로
# 쓴다(값은 backend팀 소유 — Spring backend 서비스와 같은 값을 공유해야 함, .env.dev 참고).
# prod는 KMS 봉투암호화를 쓰므로 이 키 대신 PII_KMS_KEY_ARN을 쓴다(dev에선 비움).
PII_ENC_KEY=REPLACE_ME_BASE64_32BYTES
PII_KMS_KEY_ARN=

# SQS — report-job 큐(AWS SQS Standard). SQS_ENDPOINT_URL은 실 AWS에선 비운다.
# 자격증명은 워커 IAM Role(정적 키 없음). 권한: sqs:ReceiveMessage·DeleteMessage(+Batch)·GetQueueAttributes 등.
SQS_REPORT_JOB_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/REPLACE_ME_ACCOUNT_ID/report-job

# LLM — provider 스위치(코드 기본값은 anthropic = Claude).
# 아래는 Claude 사용 시 값이다(GPU 인스턴스 없이 동작). 공식 anthropic SDK로 Claude API를 부른다.
# - AI_API_KEY: Claude API 키(시크릿 — 운영은 Secrets Manager의 AI_API_KEY). 임베딩 요청엔 실리지 않는다.
# - AI_BASE_URL은 쓰지 않는다(openai_compat 전용).
# - Opus 5.5는 thinking이 항상 켜져 있고 깊이는 LLM_EFFORT로만 조절한다. API 기본값이 medium이라
#   리포트 품질 기준(high)을 명시한다.
LLM_PROVIDER=anthropic
AI_API_KEY=REPLACE_ME
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high
# 선택(기본값이 코드에 있음): thinking+응답 합산 출력 상한 / SDK 요청 타임아웃(초)
# LLM_MAX_TOKENS=64000
# LLM_TIMEOUT_SECONDS=600
# GPU EC2 ollama(OpenAI 호환 /v1)로 되돌릴 때 — 팀 확정(8/4): Qwen3 MoE.
# EXAONE은 라이선스(상업적 사용 금지)로 사용 불가.
# LLM_PROVIDER=openai_compat
# AI_BASE_URL=http://10.0.y.y:11434/v1
# AI_API_KEY=not-needed
# LLM_MODEL=qwen3.6:35b-a3b

# 임베딩 — provider 스위치. 코퍼스(policy/case/schedule_chunks) 적재에 쓴 모델과 반드시
# 동일해야 벡터공간이 일치한다(바꾸면 코퍼스 전체 재임베딩). 코드 기본값은 voyage이고 코퍼스도
# voyage-4-large로 적재한다. 아래는 Voyage 사용 시 값이다(MongoDB Atlas 모델 API).
# - EMBEDDING_API_KEY: Atlas 모델 API 키(시크릿). 챗 키(AI_API_KEY)와 별개이며 임베딩 요청엔 이 키만 실린다.
# - input_type(query/document)·output_dimension(=EMBEDDING_DIM)은 코드가 요청에 싣는다.
EMBEDDING_PROVIDER=voyage
EMBEDDING_BASE_URL=https://ai.mongodb.com/v1
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_DIM=1024
# GPU EC2 ollama로 되돌릴 때 — 계약: qwen3-embedding 1024d(쿼리 instruction 프리픽스는 코드가 부착).
# EMBEDDING_PROVIDER=openai_compat
# EMBEDDING_BASE_URL=http://10.0.y.y:11434/v1
# EMBEDDING_MODEL=qwen3-embedding
# EMBEDDING_API_KEY=not-needed
